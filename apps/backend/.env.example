# ProjectLens AI — Backend Environment
# Copy to .env.local for native dev: cp .env.example .env.local
# Docker compose uses root .env.local instead

## Application
PROJECT_NAME=ProjectLens AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

## Database (PostgreSQL)
# Local dev (docker-compose infra): localhost:5432
# Docker backend: postgres:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/projectlens

## Cache (Redis)
# Local dev (docker-compose infra): localhost:6379
# Docker backend: redis:6379
REDIS_URL=redis://localhost:6379/0

## JWT
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

## Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage

## CORS
CORS_ORIGINS=["http://localhost:3000"]

## ChromaDB
# Docker compose maps 8001:8000 — native dev needs port 8001
CHROMA_HOST=localhost
CHROMA_PORT=8001

## Google AI Studio (primary LLM provider)
# Get a free API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

## Ollama (secondary LLM provider)
# Only used if GOOGLE_API_KEY is not set or when provider="ollama"
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
